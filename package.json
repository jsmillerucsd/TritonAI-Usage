{
  "name": "triton-usage",
  "version": "0.2.1",
  "description": "CLI to monitor API key spend and usage on TritonAI or any LiteLLM proxy",
  "type": "module",
  "bin": {
    "triton-usage": "./dist/index.js"
  },
  "files": [
    "dist",
    ".triton-usage.example.jsonc"
  ],
  "keywords": [
    "tritonai",
    "litellm",
    "usage",
    "spend",
    "monitoring",
    "cli",
    "claude-code",
    "ccusage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jsmillerucsd/TritonAI-Usage.git"
  },
  "homepage": "https://github.com/jsmillerucsd/TritonAI-Usage#readme",
  "bugs": {
    "url": "https://github.com/jsmillerucsd/TritonAI-Usage/issues"
  },
  "author": "jsmillerucsd",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
