# TritonAI base URL (optional; defaults to https://tritonai-api.ucsd.edu)
TRITONAI_BASE_URL=https://tritonai-api.ucsd.edu

# Single key (acts as the "default" key for commands)
TRITONAI_KEY=sk-...

# Named keys (will appear in the multi-key dashboard)
TRITONAI_KEY_JUDE=sk-...
TRITONAI_KEY_ALICE=sk-...
